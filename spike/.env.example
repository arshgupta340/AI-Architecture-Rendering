# spike/.env.example
#
# Copy this file to spike/.env and fill in the values for whichever providers
# you actually want to exercise. Each KEY here is read by exactly one renderer
# class (or driver) at run time via os.environ.get(...); a missing key just
# means that renderer is skipped in the bake-off, not that anything blows up.
#
# Never commit spike/.env. It is gitignored.

# --- Existing keys (already used by spike/modal_app.py and friends) ---

# Google AI Studio key. Required for:
#   - spike/renderers/nano_banana.py:NanoBananaProRenderer (gates the call;
#     the real key lives in a Modal Secret server-side)
#   - spike/modal_app.py tag_regions / Gemini 3 Pro structured output
# Sign up: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Modal CLI token, only needed for `modal run` / `modal deploy`. Locally we
# rely on `modal token new` having written ~/.modal.toml; these vars are an
# alternative form Modal also accepts in CI.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- New keys added for the Spike 2.5 multi-renderer bake-off ---

# Black Forest Labs API key. Used by:
#   - spike/renderers/flux_bfl.py:FluxCannyProRenderer
#   - spike/renderers/flux_bfl.py:FluxKontextProRenderer
# Sign up + billing: https://api.bfl.ml/  (dashboard: https://api.bfl.ml/auth/profile)
BFL_API_KEY=

# Replicate API token. Used by:
#   - spike/renderers/replicate_models.py:QwenImageEditRenderer
#   - spike/renderers/replicate_models.py:HiDreamE1Renderer
#   - spike/renderers/replicate_models.py:RecraftV3ReplicateRenderer
# Sign up: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# fal.ai key. Not yet wired into a renderer class (no spike/renderers/fal_*.py
# exists today), but reserved for the bake-off so a future fal-hosted FLUX or
# Recraft variant can drop in without another .env edit.
# Sign up: https://fal.ai/dashboard/keys
FAL_KEY=

# Magnific (Freepik / Magnific.ai) API key. Used by:
#   - spike/renderers/magnific.py:MagnificMysticRenderer
# Sign up: https://magnific.ai/  (API access is currently invite/waitlist-gated;
# Freepik Premium accounts get programmatic access via the Freepik API as well)
MAGNIFIC_API_KEY=

# Recraft API token (native Recraft API, not Replicate-hosted). Used by:
#   - spike/renderers/recraft.py:RecraftV3Renderer
# Sign up + token: https://www.recraft.ai/  -> Profile -> API
RECRAFT_API_TOKEN=
