# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/
**/.venv/

# Environment / secrets — NEVER commit
.env
**/.env
*.key
*credentials*.json
service-account*.json

# Modal
.modal/
**/.modal/

# Model weights / caches (huge, downloaded on demand)
weights/
**/weights/
.cache/
**/.cache/
hf-cache/

# IDE / Claude Code
.vscode/
.idea/
*.swp
*.swo
.claude/settings.local.json

# OS
Thumbs.db
.DS_Store
desktop.ini

# Outputs — exclude raw renders, KEEP diagnostic visualizations
**/outputs/**/*.png
**/outputs/**/*.jpg
**/outputs/**/*.jpeg
!**/outputs/**/*overlay*.png
!**/outputs/**/*sidebyside*.png
!**/outputs/**/*comparison*.png
!**/outputs/**/edges.png

# Test assets are fine to commit (small line drawings / model views)
# But ignore any heavy reference renders the user drops in
**/test_assets/**/*.mp4
**/test_assets/**/*.mov

# Backup files
*.bak
*.tmp
*~
