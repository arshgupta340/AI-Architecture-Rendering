# Copy this file to `.env.local` (gitignored) and fill in your values.

# Optional: Google Maps Tiles API key for the geo-context (Photorealistic 3D Tiles) feature.
# You can also just paste the key into the in-app "Real-world context" panel instead.
# The key needs the "Map Tiles API" enabled in Google Cloud, and Google bills per session.
VITE_GOOGLE_MAPS_API_KEY=

# FLUX.1 hero-render backend — the LIVE DEFAULT (self-hosted on your Modal GPU).
# Set these three once and the Hero render connects automatically: no per-session
# credential paste, the setup modal is skipped entirely for FLUX.1.
# Deploy first (see spike/REPORTS/modal_flux.md): `modal deploy spike/modal_flux.py`,
# then copy the printed `…heroflux-web.modal.run` base URL and append the two routes.
# FLUX.2 stays experimental/deploy-gated and is entered manually in the app's Backend card.
VITE_HERO_BASE_URL=
VITE_HERO_REGION_URL=
VITE_HERO_SECRET=
